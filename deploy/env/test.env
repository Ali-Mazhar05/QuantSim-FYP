# TEST: promoted from develop. The frontend is published to Cloudflare Pages at
# https://test.<project>.pages.dev; backend services run on the Jenkins host.
QS_ENV=test
QS_PROJECT=qs-test
COMPOSE_TARGET=local
FRONTEND_TARGET=pages
PAGES_PROJECT=quantsim
PAGES_BRANCH=test
PAGES_PRODUCTION_BRANCH=main
QS_HTTP_PORT=8082
SMOKE_BASE_URL=http://host.docker.internal:8082
TRAEFIK_LOG_LEVEL=INFO
# Websites allowed to call this environment's API from a browser
QS_CORS_ORIGINS=https://test.quantsim-4hz.pages.dev
# Accounts: emailed links open this site; mail goes through Gmail as
# alimazhar3005+QuantSim@gmail.com. The Gmail app password is SMTP_PASSWORD in the encrypted
# secrets (ci/scripts/set-secret.sh SMTP_PASSWORD all); until it is set, emails wait in
# the queue and go out once it is.
PUBLIC_APP_URL=https://test.quantsim-4hz.pages.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=alimazhar3005@gmail.com
EMAIL_REQUIRED=true
# Market data (M1). Secrets, in the encrypted file: TIINGO_API_KEY and MARKET_DB_PASSWORD
# (ci/scripts/set-secret.sh MARKET_DB_PASSWORD <env>). Everything below is not secret.
# MARKET_VENDOR: tiingo (real prices, one 50 requests/hour key shared by every
# environment) or fixture (recorded AAPL and NVDA bars, no network).
MARKET_VENDOR=tiingo
TIINGO_REQUESTS_PER_HOUR=45
TIINGO_SCHEDULED_RESERVE=40
INGEST_BACKFILL_START=2015-01-02
INGEST_OUTLIER_LOG_RETURN=0.405
INGEST_OUTLIER_POLICY=flag
# Daily and catch-up runs: TEST only, so the shared vendor budget has one scheduler.
# deploy.sh starts market-scheduler only when this is true.
QS_INGEST_SCHEDULER_ENABLED=true
