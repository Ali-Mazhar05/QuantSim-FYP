# TEST: promoted from develop. The frontend is published to Cloudflare Pages at
# https://test.<project>.pages.dev; backend services run on the Jenkins host.
QS_ENV=test
QS_PROJECT=qs-test
COMPOSE_TARGET=local
FRONTEND_TARGET=pages
PAGES_PROJECT=quantsim
PAGES_BRANCH=test
PAGES_PRODUCTION_BRANCH=main
QS_HTTP_PORT=8082
SMOKE_BASE_URL=http://host.docker.internal:8082
TRAEFIK_LOG_LEVEL=INFO
# Websites allowed to call this environment's API from a browser
QS_CORS_ORIGINS=https://test.quantsim-4hz.pages.dev
# Accounts: emailed links open this site; mail goes through Gmail as
# alimazhar+QuantSim@gmail.com. The Gmail app password is SMTP_PASSWORD in the encrypted
# secrets (ci/scripts/set-secret.sh SMTP_PASSWORD all); until it is set, emails wait in
# the queue and go out once it is.
PUBLIC_APP_URL=https://test.quantsim-4hz.pages.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=alimazhar@gmail.com
