# ACC: promoted from test. The frontend is published to Cloudflare Pages at
# https://acceptance.<project>.pages.dev. Backend services need a server: set
# COMPOSE_TARGET=ssh://deploy@<server> and SMOKE_BASE_URL once it exists.
QS_ENV=acc
QS_PROJECT=qs-acc
COMPOSE_TARGET=none
FRONTEND_TARGET=pages
PAGES_PROJECT=quantsim
PAGES_BRANCH=acceptance
PAGES_PRODUCTION_BRANCH=main
QS_HTTP_PORT=8083
TRAEFIK_LOG_LEVEL=INFO
