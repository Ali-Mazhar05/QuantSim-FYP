# PROD: promoted from acceptance after sign-off. The frontend is published to
# Cloudflare Pages at https://<project>.pages.dev. Backend services need a server:
# set COMPOSE_TARGET=ssh://deploy@<server> and SMOKE_BASE_URL once it exists.
QS_ENV=prod
QS_PROJECT=qs-prod
COMPOSE_TARGET=none
FRONTEND_TARGET=pages
PAGES_PROJECT=quantsim
PAGES_BRANCH=main
PAGES_PRODUCTION_BRANCH=main
QS_HTTP_PORT=8084
TRAEFIK_LOG_LEVEL=INFO
# true: deploy to PROD without waiting for an approver. false (default): an approver clicks Approve in Jenkins.
# Takes effect for builds of the branch that contains the change.
AUTO_APPROVE=false
# Websites allowed to call this environment's API from a browser
QS_CORS_ORIGINS=https://quantsim-4hz.pages.dev
