# PROD: promoted from acceptance after sign-off. The frontend is published to Cloudflare Pages at
# https://<project>.pages.dev. The backend (services, PostgreSQL + TimescaleDB, Redis,
# Redpanda) runs in Docker on the machine hosting Jenkins, like DEV and TEST, until
# the team moves it to a dedicated server; then set COMPOSE_TARGET=ssh://deploy@<server>
# and SMOKE_BASE_URL to that server (decision 2026-10-12).
QS_ENV=prod
QS_PROJECT=qs-prod
COMPOSE_TARGET=local
FRONTEND_TARGET=pages
PAGES_PROJECT=quantsim
PAGES_BRANCH=main
PAGES_PRODUCTION_BRANCH=main
QS_HTTP_PORT=8084
SMOKE_BASE_URL=http://host.docker.internal:8084
TRAEFIK_LOG_LEVEL=INFO
# Smaller broker than DEV and TEST: four stacks share the Jenkins host's memory
REDPANDA_MEMORY=512M
AUTO_APPROVE=false
# Websites allowed to call this environment's API from a browser
QS_CORS_ORIGINS=https://quantsim-4hz.pages.dev
# Accounts: emailed links open this site; mail goes through Gmail as
# alimazhar+QuantSim@gmail.com. The Gmail app password is SMTP_PASSWORD in the encrypted
# secrets (ci/scripts/set-secret.sh SMTP_PASSWORD all); until it is set, emails wait in
# the queue and go out once it is.
PUBLIC_APP_URL=https://quantsim-4hz.pages.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=alimazhar@gmail.com
