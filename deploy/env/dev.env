# DEV: every merge into develop. The frontend is published to Cloudflare Pages at
# https://develop.<project>.pages.dev; backend services run on the Jenkins host.
QS_ENV=dev
QS_PROJECT=qs-dev
COMPOSE_TARGET=local
FRONTEND_TARGET=pages
PAGES_PROJECT=quantsim
PAGES_BRANCH=develop
PAGES_PRODUCTION_BRANCH=main
QS_HTTP_PORT=8081
SMOKE_BASE_URL=http://host.docker.internal:8081
TRAEFIK_LOG_LEVEL=DEBUG
# Websites allowed to call this environment's API from a browser
QS_CORS_ORIGINS=https://develop.quantsim-4hz.pages.dev,http://localhost:5173
# Accounts: emailed links open this site; mail goes through Gmail as
# alimazhar3005+QuantSim@gmail.com. The Gmail app password is SMTP_PASSWORD in the encrypted
# secrets (ci/scripts/set-secret.sh SMTP_PASSWORD all); until it is set, emails wait in
# the queue and go out once it is.
PUBLIC_APP_URL=https://develop.quantsim-4hz.pages.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=alimazhar3005@gmail.com
