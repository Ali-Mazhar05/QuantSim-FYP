# Normalise text files in the repository
* text=auto

# Files executed or parsed inside Linux containers must keep LF endings
*.sh         text eol=lf
Jenkinsfile  text eol=lf
Dockerfile*  text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.conf       text eol=lf
*.env        text eol=lf
*.groovy     text eol=lf
_headers     text eol=lf
VERSION      text eol=lf

# Binary documents and images
*.pdf   binary
*.docx  binary
*.pptx  binary
*.png   binary
*.jpg   binary
*.ico   binary
